{
  "name": "mealer-backend",
  "version": "1.0.0",
  "description": "Mealer App Backend",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pnpm exec tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose down",
    "db:create": "kysely-ctl create",
    "db:mig": "tsx src/cli/migrate.ts",
    "db:rollback": "kysely-ctl rollback",
    "db:gen": "kysely-codegen --out-file src/database/types.ts"
  },
  "keywords": [],
  "author": "Adam Koziorz",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@mealer/schemas": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "kysely": "^0.28.17",
    "kysely-ctl": "^0.20.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.15.5",
    "kysely-codegen": "^0.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
